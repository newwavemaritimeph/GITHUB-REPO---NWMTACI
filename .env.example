NEXT_PUBLIC_SUPABASE_URL=
# Use the current Supabase publishable key. The legacy anon key is optional.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Direct or pooled Postgres connection used only by migration/seed scripts.
DATABASE_URL=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=New Wave Maritime <no-reply@example.com>
APP_BASE_URL=http://localhost:3000
SCHEDULED_JOB_SECRET=
CERTIFICATE_ISSUANCE_ENABLED=false
# Optional local-development preview login. Never configure these in production.
TEMP_STAFF_EMAIL=
TEMP_STAFF_PASSWORD=
TEMP_STAFF_SESSION_TOKEN=
# Set true only for an isolated UI preview. Production must always be false.
NEXT_PUBLIC_DEMO_MODE=false
